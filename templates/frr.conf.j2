frr defaults datacenter
hostname {{ name }}
no zebra nexthop kernel enable
service integrated-vtysh-config
!
router bgp {{ asn }}
 bgp router-id {{ router_id }}
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
{% for peer in peers %}
 neighbor {{ peer.remote_ip }} remote-as {{ peer.remote_asn }}
 neighbor {{ peer.remote_ip }} description {{ peer.name }}
{% endfor %}
 address-family ipv4 unicast
  network {{ loopback }}
{% for peer in peers %}
  neighbor {{ peer.remote_ip }} activate
{% endfor %}
  maximum-paths 2
 exit-address-family
 address-family l2vpn evpn
{% for peer in peers %}
  neighbor {{ peer.remote_ip }} activate
{% endfor %}
{% if role == 'leaf' %}
  advertise-all-vni
{% endif %}
 exit-address-family
exit
!
route-map LAB_SOURCE permit 10
 set src {{ router_id }}
exit
ip protocol bgp route-map LAB_SOURCE
!
